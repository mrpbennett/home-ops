{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/kubernetes/appsets/.+\\.ya?ml$/",
      "/kubernetes/clusters/portland/apps/.+\\.ya?ml$/",
      "/kubernetes/clusters/portland/CLUSTER/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ]
    }
  ],
  "platformAutomerge": true
}
